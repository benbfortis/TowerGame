    "chasm":    { "light": { "blocked": true }, "medium": { "blocked": true },  "heavy": { "speedMul": 0.5 } },
    "swamp":    { "light": { "speedMul": 0.6 },  "medium": { "speedMul": 0.55 }, "heavy": { "speedMul": 0.5 } },
